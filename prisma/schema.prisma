generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  username        String   @unique
  password        String
  first_name      String
  last_name       String
  account_created DateTime @default(now())
  account_updated DateTime @updatedAt

  @@map("users")
}

model HealthCheck {
  check_id       Int      @id @default(autoincrement())
  check_datetime DateTime @default(now()) @db.Timestamptz(6)


  @@map("health_checks")
}